{
  "name": "ParagraphLinks",
  "version": "1.0.2",
  "author": ["Luca Mauri"],
  "url": "https://github.com/lucamauri/ParagraphLinks",
  "descriptionmsg": "paragraphlinks-desc",
  "license-name": "GPL-2.0-or-later",
  "type": "other",
  "manifest_version": 2,
  "requires": {
    "MediaWiki": ">= 1.35.0",
    "platform": {
      "php": ">= 7.4"
    }
  },
  "ResourceModules": {
    "ext.paragraphlinks": {
      "localBasePath": "resources",
      "remoteExtPath": "ParagraphLinks/resources",
      "scripts": ["ext.paragraphlinks.js"],
      "styles": ["ext.paragraphlinks.css"],
      "messages": [
        "paragraphlinks-copy-link",
        "paragraphlinks-copied",
        "paragraphlinks-copy-failed"
      ]
    }
  },
  "MessagesDirs": {
    "ParagraphLinks": ["i18n"]
  },
  "HookHandlers": {
    "ParagraphLinksHookHandler": {
      "class": "MediaWiki\\Extension\\ParagraphLinks\\ParagraphLinksHooks",
      "services": ["MainConfig"]
    }
  },
  "Hooks": {
    "BeforePageDisplay": "ParagraphLinksHookHandler"
  },
  "AutoloadNamespaces": {
    "MediaWiki\\Extension\\ParagraphLinks\\": "includes/"
  },
  "config": {
    "ParagraphLinksEnabled": {
      "value": true,
      "descriptionmsg": "paragraphlinks-config-enabled"
    },
    "ParagraphLinksNamespaces": {
      "value": [0, 4, 10, 12, 14],
      "descriptionmsg": "paragraphlinks-config-namespaces"
    }
  }
}
